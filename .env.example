# Runtime
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGINS=http://localhost:8505
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=480
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/thankyouforcalling_intelligence
SQLITE_FALLBACK_URL=sqlite:///./thankyouforcalling.db
UPLOAD_DIR=backend/uploads

# Provider mode: false uses live provider REST APIs; true enables deterministic demo data.
MOCK_PIPELINE=true
PIPELINE_TIMEOUT_SECONDS=600
HF_PYANNOTE_TOKEN=
HF_EMOTION_TOKEN=
GROQ_API_KEY_WHISPER=
GROQ_API_KEY_EVAL=
GROQ_API_KEY_VERIFY=

# Bootstrap only on an empty database; change before first production startup.
BOOTSTRAP_ADMIN_EMAIL=admin@thankyouforcalling.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeImmediately!
BOOTSTRAP_ADMIN_NAME=TFC Admin
